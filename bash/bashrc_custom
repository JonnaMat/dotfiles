# --- GIT ----------------------------------------------------------------------

alias gca="git commit --amend --no-edit"
alias gc="git commit"

alias grh="git reset --hard @{u}"
alias gp="git pull"
alias grc="git rebase --continue"

alias gs="git stash"

gpf() {
  git reset --hard @{u}
  git pull
}

# undo last commit but keep changes
gundo() {
  git reset HEAD^
}

gcm() {
    git checkout master
    git pull
}

gcmf() {
    git stash
    git checkout master
    git reset --hard @{u}
    git pull
}

gri() {
   if [ "$1" ]; then
        git rebase -i HEAD~$1
    else
        echo "Argument missing: git rebase -i HEAD~\$1"
    fi
}

